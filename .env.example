# Copy this file to .env.development / .env.staging / .env.production
# and fill in real values. NODE_ENV selects which file is loaded.
# The app throws at startup if any required variable is missing.

NODE_ENV=development
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=ChangeMe_123!
DB_NAME=aggri_ai
DB_SSL=false
# Never enable synchronize in staging/production - use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Gemini - used for the Phase 3 AI sanity-check (judgment-heavy task)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq - used for Phase 4 summarization (higher volume, simpler task)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Secret Vercel Cron sends as `Authorization: Bearer <value>` on scheduled
# requests to GET /pipeline/cron - see cron-auth.guard.ts. Generate a random
# string (16+ chars) and set the same value in the Vercel project's env vars.
CRON_SECRET=

# Pipeline tuning
INGESTION_CRON=0 0 * * * *
PIPELINE_CRON=0 0 17 * * *
CLUSTER_WINDOW_HOURS=12
CLUSTER_SIMILARITY_THRESHOLD=0.4
RANKING_TOP_N=20
CORROBORATION_CAP=5
