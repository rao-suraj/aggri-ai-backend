# Copy this file to .env.development / .env.staging / .env.production
# and fill in real values. NODE_ENV selects which file is loaded.
# The app throws at startup if any required variable is missing.

NODE_ENV=development
PORT=3000

# SQL Server connection
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=ChangeMe_123!
DB_NAME=aggri_ai
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Never enable synchronize in staging/production - use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Gemini - used for the Phase 3 AI sanity-check (judgment-heavy task)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq - used for Phase 4 summarization (higher volume, simpler task)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Pipeline tuning
INGESTION_CRON=0 0 * * * *
PIPELINE_CRON=0 0 17 * * *
CLUSTER_WINDOW_HOURS=12
CLUSTER_SIMILARITY_THRESHOLD=0.4
RANKING_TOP_N=20
CORROBORATION_CAP=5
